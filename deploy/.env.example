# CyberGym 跑批配置。复制成 .env 后按需修改：
#   cd deploy && cp .env.example .env

# 编排器镜像（一般不用改）
RUNNER_IMAGE=trilane-batch-runner:latest

# 批次名字。同一个名字 = 同一个工作区，续跑会跳过已完成的任务
BATCH_NAME=batch-1
# 容器名。同一台机器上同时跑多个批次时要区分开
CONTAINER_NAME=trilane-batch
# 上传归账用的智能体 id，同一批用同一个
AGENT_ID=trilane-prod-1

# 智能体镜像（跑批时逐任务拉起的 trilane-headless 版本）
AGENT_IMAGE=trilane-headless:1.0.1

# 智能体 Docker 隔离：dind（默认，每任务独立 daemon）或 host（旧行为，直连宿主 daemon）
ISOLATION=dind
# DinD 镜像；dind 容器需要 --privileged
DIND_IMAGE=docker:dind

# 数据集根（含 data/arvo、data/oss-fuzz）
DATA_DIR=/opt/cybergym_data
# 脱敏表，必须与服务端加载的同一份
MASK_MAP=/opt/mask_map.json
# 任务列表：子目录 Tasks 挂进容器内的 /tasklist（目标固定，不能改）
TASKS_DIR=./tasks
# 容器内的任务列表路径
TASKS_FILE=/tasklist/tasks.txt
# 产物根
WORK_ROOT=/var/lib/trilane
# 宿主 ~/.trilane（config.toml + secrets.toml）
TRILANE_HOME=/root/.trilane

# 提交服务端。compose 用了 network_mode: host，容器内 127.0.0.1 就是宿主，
# 所以默认写 127.0.0.1 即可。
# 若要改成 host.docker.internal（例如服务端在 compose 的另一个容器里，或想显式表达）：
#   CYBERGYM_SERVER=http://host.docker.internal:8666
# compose.batch.yaml 已加 extra_hosts 映射，host 模式下也能解析。实测两者都通。
CYBERGYM_SERVER=http://127.0.0.1:8666
# 服务端启动时用的那个 key（fix 侧判定走私有路由）
CYBERGYM_API_KEY=change-me-to-your-server-key

# checksum 盐值，**必须与服务端一致**，否则提交一律 400 Invalid checksum。
# 服务端默认 CyberGym；改过就在两边同时改。
# 查服务端当前值：
#   docker inspect cybergym-server --format '{{range .Config.Env}}{{println .}}{{end}}' | grep SALT
CYBERGYM_SALT=CyberGym

# 并发任务数。每个目标容器上限 4GB，并发 N 需要 N×4GB 内存
CONCURRENCY=1
# 单任务超时（秒）
TASK_TIMEOUT_SEC=14400
# 智能体因容器 OOM/启动失败/模型断流而中断时，批内自动重试几次
AGENT_RETRIES=1
# 每任务最多试几个候选 / 每个候选投票几轮
MAX_SUBMITS=3
VERIFY_ROUNDS=3

TZ=Asia/Shanghai
